# Better Auth + PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/scouticket
POSTGRES_DB=scouticket
POSTGRES_USER=scouticket
POSTGRES_PASSWORD=scouticket
BETTER_AUTH_SECRET=generate_a_long_random_secret
# Secret distinct pour pseudonymiser les identifiants dans les journaux d'audit
AUDIT_LOG_SECRET=generate_a_different_long_random_secret
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# URL publique de l'application, utilisée dans les liens envoyés par e-mail
APP_URL=

# Active la page de maintenance et désactive les API (true ou false)
MAINTENANCE_MODE=false

# OpenObserve RUM (optionnel, uniquement côté navigateur)
# Laissez ces valeurs vides pour désactiver la collecte.
NEXT_PUBLIC_OPENOBSERVE_SITE=
NEXT_PUBLIC_OPENOBSERVE_CLIENT_TOKEN=
NEXT_PUBLIC_OPENOBSERVE_ORGANISATION=default

# SMTP Configuration (Generic - works with any email provider)
# Configuration serveur SMTP (fonctionne avec n'importe quel fournisseur d'email)

# Host SMTP de votre fournisseur
SMTP_HOST=your-smtp_host

# Port SMTP (587 pour TLS, 465 pour SSL, 25 pour non-sécurisé)
SMTP_PORT=your-smtp_port

# Utiliser SSL/TLS (true pour port 465, false pour port 587)
SMTP_SECURE=your-smtp_secure

# Identifiants SMTP
SMTP_USER=your-smtp_user
SMTP_PASSWORD=your-smtp_password

# Optionnel : Personnaliser l'expéditeur (utile si SMTP_USER ≠ adresse email, ex : Resend)
SMTP_FROM=your-smtp_from
SMTP_FROM_NAME=your-smtp_from_name
# Optionnel : compatibilité descendante si vous préférez séparer nom/adresse
SMTP_FROM_EMAIL=your-smtp_from_email

# GMAIL_APP_PASSWORD=your-# gmail_app_password
# L'adresse de trésorerie est désormais renseignée et validée par chaque groupe
# dans l'application. Ne pas ajouter d'adresse globale ici.

# Exemples de configuration pour différents fournisseurs :
#
# Gmail :
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-#   smtp_user
#   SMTP_PASSWORD=your-#   smtp_password
#
# Office 365 :
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-#   smtp_user
#   SMTP_PASSWORD=your-#   smtp_password
#
# Serveur SMTP personnalisé :
#   SMTP_HOST=your-#   smtp_host
#   SMTP_PORT=your-#   smtp_port
#   SMTP_SECURE=your-#   smtp_secure
#   SMTP_USER=your-#   smtp_user
#   SMTP_PASSWORD=your-#   smtp_password
