{
  "name": "scouticket",
  "version": "1.1.0",
  "packageManager": "pnpm@11.22.0",
  "private": true,
  "description": "Application de gestion de justificatifs et de notes de frais pour les scouts",
  "license": "MIT",
  "homepage": "https://scouticket.fr",
  "author": {
    "name": "Yipfram",
    "email": "romain@romain-rochas.fr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yipfram/sgdf-notes-de-frais.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pnpm lint && pnpm type && pnpm test && pnpm build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "format": "prettier --write . --ignore-path .prettierignore --ignore-unknown",
    "format:check": "prettier --check . --ignore-path .prettierignore --ignore-unknown",
    "type": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-base-de-donnees.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "auth:migrate": "pnpm dlx auth@1.7.3 migrate",
    "migrate:clerk": "node --env-file-if-exists=.env scripts/migrate-clerk.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.5",
    "@openobserve/browser-logs": "0.4.2",
    "@openobserve/browser-rum": "^0.4.2",
    "better-auth": "^1.7.3",
    "next": "16.3.1",
    "nodemailer": "^8.0.4",
    "pg": "^8.23.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.67.0",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.4",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.0.7",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^8.1.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.9"
  }
}
